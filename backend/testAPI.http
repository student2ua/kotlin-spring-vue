# @name=авторизируемся
POST http://localhost:8080/openAPI/api/auth/signin  HTTP/1.1
Content-Type: application/json;charset=UTF-8
Accept: application/json, text/plain, */*

{ "email" : "forTest" , "password" : "testpass" }


> {%
     client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
     client.test("Response content-type is json", function() {
        var type = response.contentType.mimeType;
        client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
    });
    client.global.set("auth_token", response.body.accessToken);
   %}


###
# @name=получаем список предметов
GET http://localhost:8080/openAPI/api/mark/rest/v199/subjects HTTP/1.1
Authorization: Bearer {{auth_token}}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Response content-type is json", function() {
       var type = response.contentType.mimeType;
      client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
    });
   // Извлечение значений 'first' и сохранение их в переменную
    client.test("Response body is valid and contains data", function() {
        // Логируем тело ответа для диагностики
        client.log("Response body: " + response.body);
        client.log("Response body type: " + typeof response.body);

        // Проверяем, что тело ответа существует
        client.assert(response.body, "Response body is empty or undefined");

        // response.body уже является объектом (массивом), используем его напрямую
        var jsonData = response.body;

        // Проверяем, что jsonData - массив
        client.assert(jsonData instanceof Array, "Response body is not an array");

        // Извлекаем значения 'first'
        var firstValues = jsonData.map(function(item) { return item.first; });
        client.global.set("sid", JSON.stringify(firstValues[0]));
        client.log("sid: " + client.global.get("sid"));

        // Тестирование корректности извлечения
        client.assert(firstValues.length > 0, "First values array is empty");
        client.assert(JSON.stringify(firstValues) === JSON.stringify([3, 1, 2]), "First values do not match expected [3, 1, 2]");
    });

    %}

