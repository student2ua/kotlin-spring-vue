# @env dev
# @name=handsontable
GET {{baseUrl}}/api/mark/rest/v199/subjects/{{sid}}/lessontypes/{{ltid}}/psgs/{{psgid}}/handsontable
Authorization: Bearer {{auth_token}}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
  // Проверка структуры ответа и извлечение данных
    client.test("Response body is valid and contains required arrays", function() {
        // Логируем тело ответа и его тип для диагностики
        client.log("Response body: " + response.body);
        client.log("Response body type: " + typeof response.body);

        // Проверяем, что тело ответа существует и является объектом
        client.assert(response.body, "Response body is empty or undefined");
        client.assert(typeof response.body === "object" && response.body !== null, "Response body is not an object");

        var jsonData = response.body;

        // Проверка наличия и непустоты nestedHeaders
        client.assert(jsonData.nestedHeaders instanceof Array, "nestedHeaders is not an array");
        client.assert(jsonData.nestedHeaders.length > 0, "nestedHeaders array is empty");

        // Проверка наличия и непустоты columns
        client.assert(jsonData.columns instanceof Array, "columns is not an array");
        client.assert(jsonData.columns.length > 0, "columns array is empty");

        // Проверка наличия и непустоты tabledata
        client.assert(jsonData.tabledata instanceof Array, "tabledata is not an array");
        client.assert(jsonData.tabledata.length > 0, "tabledata array is empty");

        // Проверка наличия и непустоты col
        client.assert(jsonData.col && typeof jsonData.col === "object" && !Array.isArray(jsonData.col), "col is not an object");
        client.assert(Object.keys(jsonData.col).length > 0, "col object is empty");

        // Проверка наличия и непустоты rows
        client.assert(jsonData.rows instanceof Array, "rows is not an array");
        client.assert(jsonData.rows.length > 0, "rows array is empty");

        // Additional check: col.length + 4 = tabledata[0].length
        var colKeysLength = Object.keys(jsonData.col).length;
        var tableDataFirstLength = Object.keys(jsonData.tabledata[0]).length;
        client.assert(colKeysLength + 4 === tableDataFirstLength,
            "col keys length (" + colKeysLength + ") + 4 does not equal tabledata[0] keys length (" + tableDataFirstLength + ")");

        // Additional check: tabledata.length = rows.length
        client.assert(jsonData.tabledata.length === jsonData.rows.length,
            "tabledata length (" + jsonData.tabledata.length + ") does not equal rows length (" + jsonData.rows.length + ")");

        // Извлечение studentNames из tabledata
        var studentNames = jsonData.tabledata.map(function(item) { return item.A; });
        // client.global.set("studentNames", JSON.stringify(studentNames));

        // Тестирование корректности извлечения studentNames
        client.assert(studentNames.length > 0, "Student names array is empty");
        client.assert(studentNames.indexOf("Ли Джо́рдан") !== -1, "Expected student name 'Ли Джо́рдан' not found");
        client.assert(studentNames.indexOf("Кэ́ти Белл") !== -1, "Expected student name 'Кэ́ти Белл' not found");

        // Дополнительное сохранение rows (если нужно)
        // client.global.set("rows", JSON.stringify(jsonData.rows));

        // Логирование для диагностики
        client.log("nestedHeaders[0]: " + JSON.stringify(jsonData.nestedHeaders[0]));
        client.log("columns[0]: " + JSON.stringify(jsonData.columns[0]));
        client.log("tabledata[0]: " + JSON.stringify(jsonData.tabledata[0]));
        client.log("col: " + JSON.stringify(jsonData.col));
        client.log("rows: " + JSON.stringify(jsonData.rows));
        client.log("studentNames: " + JSON.stringify(studentNames));
    });
    %}

