# @name=список типов
GET http://localhost:8080/openAPI/api/mark/rest/v199/subjects/{{sid}}/lessontypes HTTP/1.1
Authorization: Bearer {{auth_token}}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Response content-type is json", function() {
       var type = response.contentType.mimeType;
      client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
    });

    client.test("Response body is valid and contains data", function() {
        client.log("Response body: " + response.body);
        client.log("Response body type: " + typeof response.body);

        client.assert(response.body, "Response body is empty or undefined");

        var jsonData = response.body;
        client.assert(jsonData instanceof Array, "Response body is not an array");

        var lessonTypeIds = jsonData.map(function(item) { return item.first; });
        client.global.set("ltid", JSON.stringify(lessonTypeIds[1]));

        client.assert(lessonTypeIds.length > 0, "Lesson type IDs array is empty");
        client.assert(JSON.stringify(lessonTypeIds) === JSON.stringify([3, 2, 1]), "Lesson type IDs do not match expected [3, 2, 1]");
    });

    %}

###  @name Planned groups
GET http://localhost:8080/openAPI/api/mark/rest/v199/subjects/{{sid}}/lessontypes/{{ltid}}/psgs
Authorization: Bearer {{auth_token}}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Response content-type is json", function() {
       var type = response.contentType.mimeType;
      client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
    });

    client.test("Response body is valid and contains data", function() {
        client.log("Response body: " + response.body);
        client.log("Response body type: " + typeof response.body);

        client.assert(response.body, "Response body is empty or undefined");

        var jsonData = response.body;
        client.assert(jsonData instanceof Array, "Response body is not an array");

       var psgIds = jsonData.map(function(item) { return item.first; });
        client.global.set("psgid", JSON.stringify(psgIds[1]));

        client.assert(psgIds.length > 0, "Lesson type IDs array is empty");
        client.assert(JSON.stringify(psgIds) === JSON.stringify([2, 4, 3, 1]), "Lesson type IDs do not match expected [3, 2, 1]");
    });

    %}

